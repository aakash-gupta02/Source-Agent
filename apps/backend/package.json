{
  "name": "backend",
  "version": "1.0.0",
  "description": "Production-grade modular Express REST API starter with TypeScript.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "db:mig": "prisma migrate dev && prisma generate",
    "db:gen": "prisma generate",
    "db:stu": "prisma studio",
    "db:push": "prisma db push"
  },
  "keywords": [
    "express",
    "typescript",
    "rest-api",
    "jwt",
    "zod"
  ],
  "author": "aakashgupta",
  "license": "ISC",
  "dependencies": {
    "@langchain/mistralai": "^1.2.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@repo/agent": "*",
    "@repo/db": "*",
    "@repo/shared": "*",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "google-auth-library": "^10.9.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.19.2",
    "morgan": "^1.10.1",
    "pg": "^8.22.0",
    "winston": "^3.18.3",
    "zod": "^4.1.11"
